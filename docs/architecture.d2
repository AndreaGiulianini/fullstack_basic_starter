# Architecture diagram — migration/angular-c# (Angular 22 + ASP.NET Core 10)
#
# Source of truth: compose.yaml + compose_override/development.yaml
# Regenerate with ./docs/render.sh

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 30
  }
}

direction: right

classes: {
  svc: {
    style: {
      stroke: "#4a5568"
      fill: "#ffffff"
      shadow: true
      border-radius: 8
      font-size: 14
    }
  }
  store: {
    shape: cylinder
    style: {
      stroke: "#2c5282"
      fill: "#ebf8ff"
      font-size: 14
    }
  }
  flow: {
    style: {
      stroke: "#dd6b20"
      stroke-width: 3
      font-size: 13
      bold: true
    }
  }
  infra: {
    style: {
      stroke: "#a0aec0"
      font-size: 12
    }
  }
}

browser: "Browser\nhttp://localhost\n\nAngular SPA — no server-side render" {
  class: svc
  icon: ./icons/browser.svg
  style.fill: "#f7fafc"
}

compose: "Docker Compose — development" {
  direction: right
  icon: ./icons/docker.svg
  style: {
    stroke: "#2496ed"
    stroke-dash: 3
    fill: "#fbfdff"
    font-size: 16
    bold: true
  }

  traefik: "traefik\nTraefik 3.7.10\n:80 · :443 · :8080" {
    class: svc
    icon: ./icons/traefik.svg
    style.fill: "#fffaf0"
  }

  app: "app · Angular 22 — :4200 dev / :80 prod\nStandalone components · Signals\nZoneless change detection · SCSS" {
    class: svc
    icon: ./icons/angular.svg
  }

  api: "api · ASP.NET Core 10 — :5000\nClean Architecture · EF Core 10\nIdentity + JWT · Asp.Versioning /api/v1\nSerilog logs · Swashbuckle" {
    class: svc
    icon: ./icons/dotnet.svg
  }

  data: "Stateful services — defined in compose_override/development.yaml" {
    direction: down
    style: {
      stroke: "#90cdf4"
      fill: "#f7fbff"
      font-size: 13
    }

    pg: "postgres_db · Postgres 18.6 — :5432\nusers · session · account · verification\n+ ASP.NET Identity tables" {
      class: store
      icon: ./icons/postgresql.svg
    }

    valkey: "valkey · Valkey 9 — :6379\ncache via StackExchange.Redis" {
      class: store
      icon: ./icons/valkey.svg
    }

    es: "elasticsearch · 9.5.1 — :9200\nindex api-logs-{yyyy.MM.dd}" {
      class: store
      icon: ./icons/elasticsearch.svg
      style.stroke: "#2f855a"
      style.fill: "#f0fff4"
    }

    kibana: "kibana · 9.5.1 — :5601" {
      class: svc
      icon: ./icons/kibana.svg
      style.fill: "#f0fff4"
    }
  }
}

# ── Example client request: authenticated GET /api/v1/users/{id} ───────────
browser -> compose.traefik: "1 · GET /api/v1/users/{id}\nHttpOnly JWT cookie" {class: flow}
compose.traefik -> compose.api: "2 · PathPrefix(/api) priority 10\n→ api:5000" {class: flow}
compose.api -> compose.data.pg: "3 · JWT validated, session read\n4 · EF Core query" {class: flow}
compose.api -> compose.data.valkey: "4 · cache" {class: flow}
compose.api -> compose.data.es: "5 · Serilog sink" {class: flow}

# ── Static topology ────────────────────────────────────────────────────────
compose.traefik -> compose.app: "PathPrefix(/) priority 1\n→ :4200" {class: infra}
compose.traefik -> compose.api: "PathPrefix(/swagger)\nDevelopment only" {class: infra}
compose.data.kibana -> compose.data.es: "queries" {class: infra}
